# ==============================================================================
# SpecSure Environment Variables Template (Reference Only)
# Copy this file to .env and configure your environment-specific values.
# DO NOT commit real secrets, passwords, or API keys to version control.
# ==============================================================================

# Database Configuration (PostgreSQL with pgvector extension OR SQLite)
# Reference: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
# For zero-config local SQLite: sqlite+aiosqlite:///./specsure.db
DATABASE_URL=
DATABASE_URL_SYNC=

# Gemini API Key (Optional — for natural language explanations & extraction)
# Reference: AIzaSy... (Get from Google AI Studio)
GEMINI_API_KEY=

# Embedding Model Configuration (sentence-transformers)
# Reference: intfloat/multilingual-e5-large | BAAI/bge-m3 | all-MiniLM-L6-v2 | none
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Cross-Encoder Reranker Model
# Reference: BAAI/bge-reranker-v2-m3 | none
RERANKER_MODEL=
CORPUS_EMBEDDING_MODEL=

# Application Server Settings
# Reference: host (e.g., 0.0.0.0 or 127.0.0.1) and port (e.g., 8000)
APP_HOST=
APP_PORT=
FRONTEND_URL=
LOG_LEVEL=

# BIS Data Scraping Settings
# Reference: Delay in seconds between requests (e.g., 2.0)
BIS_SCRAPE_DELAY_SECONDS=

# Retrieval & Graph Settings
# Reference: Number of results to retrieve/rerank (e.g., integers)
TOP_K_DENSE=
TOP_K_BM25=
TOP_K_RERANK=
TOP_K_FINAL=
GRAPH_MAX_DEPTH=

# Demo Data & Mode Flags
# Reference: 1 to seed demo data on first start, 0 to skip
SEED_DEMO=

# Document AI & Processing Options (Optional)
# Reference: 1 to enable Docling, 0 to disable
SPECSURE_USE_DOCLING=

# Cryptographic Keys (Optional)
# Reference: Base64-encoded Ed25519 private key for W3C VC signing
SPECSURE_ISSUER_KEY_B64=
