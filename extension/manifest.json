{
  "manifest_version": 3,
  "name": "SpecSure — Indian Standards assistant (prototype)",
  "short_name": "SpecSure",
  "version": "0.3.0",
  "description": "Shows the applicable Indian Standards, edition in force, amendments and compulsory certification next to e-procurement bid listings and bid documents. Prototype for SIH 2026 (PS SIH26108); not affiliated with GeM or BIS.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "SpecSure — Indian Standards", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "contextMenus", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://bidplus.gem.gov.in/*",
    "https://gem.gov.in/*",
    "https://eprocure.gov.in/*",
    "https://etenders.gov.in/*",
    "https://*.gov.in/*",
    "https://*.nic.in/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://bidplus.gem.gov.in/*", "http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
